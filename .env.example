# URL pubblico del server licenze, per esempio https://licenze.kreluna.it
RISONIX_LICENSE_API_URL=
# Segreto casuale condiviso soltanto tra il sito e il server licenze
RISONIX_SITE_SECRET=

# Ciclo commerciale Risonix — tutti i valori restano server-side.
# Interruttore finale: lasciare false finché installer, firma, consegna e rimborso non sono collaudati.
RISONIX_SALES_ENABLED=false
RISONIX_PUBLIC_ORIGIN=
# test usa sk_test_; live usa sk_live_. Non attivare live prima del collaudo completo del webhook.
RISONIX_STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price Stripe one-time: 49,00 EUR IVA inclusa. Per una promozione futura si cambia il Price ID, non il motore licenze.
RISONIX_STRIPE_PRICE_ID=
RISONIX_STRIPE_EXPECTED_AMOUNT=4900
RISONIX_STRIPE_CURRENCY=eur
RISONIX_STRIPE_TAX_BEHAVIOR=inclusive
RISONIX_PRICE_DISPLAY=49,00 € IVA inclusa
# 32 byte casuali in base64url, usati per cifrare email e chiave licenza negli ordini D1.
RISONIX_ORDER_ENCRYPTION_KEY_B64=
RISONIX_DOWNLOAD_MAC_URL=
# Download protetto dell'MSI Windows firmato. Le vendite restano bloccate se manca.
RISONIX_DOWNLOAD_WINDOWS_URL=
# Provider email HTTP compatibile con payload {from,to,subject,text,html}.
RISONIX_EMAIL_PROVIDER=
RISONIX_EMAIL_API_URL=
RISONIX_EMAIL_API_KEY=
RISONIX_EMAIL_FROM=
RISONIX_SELLER_LEGAL_NAME=
RISONIX_SELLER_VAT_ID=
RISONIX_TERMS_URL=
RISONIX_PRIVACY_URL=
RISONIX_REFUND_POLICY_URL=
