DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes
FileETag MTime Size

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/x-component .rsc
  AddType text/javascript .js
  AddType font/woff2 .woff2
</IfModule>

<Files "feed.xml">
  ForceType application/rss+xml
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Retire old public addresses with one direct canonical redirect.
  RewriteRule ^en\.html$ https://www.kreluna.it/en/ [R=301,L,NE]
  RewriteRule ^en$ https://www.kreluna.it/en/ [R=301,L,NE]
  RewriteRule ^in-arrivo\.html$ https://www.kreluna.it/ [R=301,L,NE]
  RewriteRule ^kreluna-ai(?:/index\.html)?/?$ https://www.kreluna.it/intelligenza-artificiale-aziende.html [R=301,L,NE]

  # The restaurant partner program only exists in English; send the other
  # locale paths to the real page instead of a 404.
  RewriteRule ^velvet-table/restaurants/founding-100/?$ https://www.kreluna.it/en/velvet-table/restaurants/founding-100 [R=301,L,NE]
  RewriteRule ^velvet-table/restaurants/?$ https://www.kreluna.it/en/velvet-table/restaurants [R=301,L,NE]
  RewriteRule ^(fr|es|de)/velvet-table/restaurants/founding-100/?$ https://www.kreluna.it/en/velvet-table/restaurants/founding-100 [R=301,L,NE]
  RewriteRule ^(fr|es|de)/velvet-table/restaurants/?$ https://www.kreluna.it/en/velvet-table/restaurants [R=301,L,NE]

  # Remove explicit index filenames before the general host redirect.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ https://www.kreluna.it/$1 [R=301,L,NE]

  # Enforce a single public origin while preserving path and query string.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.kreluna\.it$ [NC]
  RewriteRule ^ https://www.kreluna.it%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://sepolia.base.org; manifest-src 'self'; worker-src 'self' blob:"

  <FilesMatch "\.(?:html|rsc|xml|json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml application/rss+xml image/svg+xml application/manifest+json text/x-component
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml application/rss+xml image/svg+xml application/manifest+json text/x-component
</IfModule>
